# Allow Settings to read ro.vendor.build.security_patch
get_prop(system_app, vendor_security_patch_level_prop)

# Allow access to the HALs
hal_client_domain(system_app, hal_lineage_touch)

# Allow Settings (Picked features) to set fast wireless charging and Wireless PowerShare
hal_client_domain(system_app, hal_lineage_health)
hal_client_domain(system_app, hal_lineage_powershare)

# Allow access to governor node
allow system_app sysfs_devices_system_cpu:file write;

# Zygote
allow system_app zygote:unix_stream_socket getopt;

# Allow Settings (Picked features) to request a GPU driver switch and show the active driver
set_prop(system_app, picked_mali_prop)
get_prop(system_app, bootloader_prop)

# Allow Settings (Picked features) to import a custom boot animation
allow system_app picked_bootanim_file:dir rw_dir_perms;
allow system_app picked_bootanim_file:file create_file_perms;

# Allow Settings (Picked features > Battery health) to read the battery's power_supply nodes
# Disabled locally: violates the platform neverallow in system/sepolicy/private/domain.te (full treble)
# r_dir_file(system_app, sysfs_batteryinfo)

# Allow Settings (Picked features > Desktop mode on a monitor) to set the desktop experience
# property (persist.wm.debug.desktop_experience_devopts)
userdebug_or_eng(`
  set_prop(system_app, persist_wm_debug_prop)
')

# Allow Settings (Picked features > Ad blocker) to write the merged hosts file and switch it
allow system_app picked_adblock_file:dir rw_dir_perms;
allow system_app picked_adblock_file:file create_file_perms;
